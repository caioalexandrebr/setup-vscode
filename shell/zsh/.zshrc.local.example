# ~/.zshrc.local — machine-specific, NOT in git
#
# Copy to ~/.zshrc.local and fill in. Sourced near the end of ~/.zshrc (before
# the plugins), so it can override aliases and variables set there.
#
# What belongs here: anything that only makes sense on this machine or inside
# one company — corporate CA bundles, internal CLIs and their aliases, helper
# functions for private repos, and secrets. Keep all of it out of this repo.

# ----------------------------------------------------- corporate CA bundle ---
# Behind a TLS-inspecting proxy, point tools at the corporate root CA.
# CA="$HOME/.config/corp-ca/root.pem"
# export NODE_EXTRA_CA_CERTS="$CA"
# export SSL_CERT_FILE="$CA"
# export REQUESTS_CA_BUNDLE="$CA"
# export CURL_CA_BUNDLE="$CA"
# export AWS_CA_BUNDLE="$CA"

# ------------------------------------------------------------- navigation ---
# Shortcuts to work folders, e.g.:
# alias work='cd ~/dev/my-company'

# ---------------------------------------------------------- internal tools ---
# Aliases and helper functions for company-internal CLIs, e.g.:
# alias xyz='some-internal-cli run'
# my-plugin-update() { ... }

# ------------------------------------------------------- optional toolchains ---
# Only if installed on this machine:
# export PATH="$HOMEBREW_PREFIX/opt/openjdk/bin:$PATH"           # Java
# export PATH="$PATH:$HOME/go/bin"                               # Go
# export PATH="$HOME/Library/Android/sdk/platform-tools:$PATH"   # Android
# export AWS_VAULT_BACKEND=file                                  # aws-vault

# ------------------------------------------------------------------ secrets ---
# This file is gitignored, so real tokens can live here — but prefer a secrets
# manager or the macOS Keychain when the tool supports it.
#   export SOME_TOKEN='value'
