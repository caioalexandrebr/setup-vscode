# Ghostty — macOS terminal. Linked to ~/.config/ghostty/config by install.sh.
# Reload after editing: Cmd+Shift+,  ·  List themes: ghostty +list-themes

# Appearance
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = JetBrains Mono
font-size = 14
window-padding-x = 10
window-padding-y = 8
background-opacity = 0.97
macos-titlebar-style = tabs
cursor-style = bar

# Behavior
shell-integration = zsh
copy-on-select = clipboard
confirm-close-surface = false
window-save-state = always
mouse-hide-while-typing = true
macos-option-as-alt = true

# Splits (Cmd+D right, Cmd+Shift+D down are built in)
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom

# Global quick terminal, toggled from any app (needs Accessibility permission)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
